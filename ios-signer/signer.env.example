# ==============================================================================
# Configuración de SCInsta iOS Auto-Signer (/ios-signer/signer.env)
# IMPORTANTE: Copiar a signer.env y proteger permisos con:
#   cp signer.env.example signer.env && chmod 600 signer.env
# ==============================================================================

UDID=
APPLE_ID=
APP_PASSWORD=
WEBHOOK_SECRET=
PUSH_WEBHOOK_URL=http://127.0.0.1:3000/api/notify
IPA_PATH=/home/<usuario>/scinsta-infra/ios-signer/SCInsta.ipa
